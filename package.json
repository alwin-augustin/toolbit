    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "asn1js": "^3.0.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convert-units": "^2.3.4",
    "cron-parser": "^5.10.1",
    "cronstrue": "^3.27.0",
    "cssbeautify": "^0.3.1",
    "csso": "^5.0.5",
    "date-fns": "^4.4.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.12",
    "graphql": "^17.0.2",
    "js-yaml": "^5.4.2",
    "lucide-react": "^1.49.0",
    "marked": "^18.0.14",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "pkijs": "^3.4.1",
    "prismjs": "^1.30.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-simple-code-editor": "^0.14.1",
    "react-window": "^2.3.3",
    "tailwind-merge": "^3.7.0",
    "terser": "^5.51.2",
    "wouter": "^3.13.0",
    "zustand": "^5.0.15"
