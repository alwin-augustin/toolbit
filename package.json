{
  "name": "toolbit",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Toolbit",
    "email": "alwinaugustin@gmail.com"
  },
  "description": "A comprehensive collection of developer utilities",
  "scripts": {
    "dev": "npm run web:dev",
    "build": "npm run web:build",
    "preview": "vite preview",
    "check": "tsc",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "web:dev": "vite",
    "web:build": "vite build && npm run seo:generate && npm run pwa:generate",
    "web:build:preview": "VITE_DISABLE_PWA=true vite build && npm run seo:generate",
    "web:preview": "npm run web:build:preview && VITE_DISABLE_PWA=true vite preview",
    "seo:generate": "node scripts/generate-seo-pages.mjs",
    "seo:og-image": "node scripts/generate-og-image.mjs",
    "seo:screenshots": "node scripts/generate-screenshots.mjs",
    "pwa:generate": "node scripts/generate-service-worker.mjs",
    "test:e2e": "playwright test",
    "test:run": "vitest run",
    "benchmark": "tsx scripts/benchmark-tools.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
