# Desktop target — the Tauri host bundles this build.
#
# Selected with `vite --mode desktop` (see `dev:desktop` / `build:desktop`).
# Hiding the web-only routes is a build decision: the marketing page, the SEO
# shell and the "install as PWA" prompt have no meaning in an installed app.
VITE_TARGET=desktop

# The desktop shell serves the assets out of the app bundle, so a service worker
# would only add a second cache to keep in step with the binary.
VITE_DISABLE_PWA=true
