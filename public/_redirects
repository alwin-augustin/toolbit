# Tools moved from /app/<slug> to /<slug>. The old URLs are in the wild — they
# were in the previous sitemap — so they get a permanent redirect rather than a
# 404, which also passes the ranking signal on to the new URL.
/app/:slug    /:slug    301
/app          /         301

# An earlier revision of this branch served per-tool landing pages under
# /tools/<slug>; those are now the tool pages themselves.
/tools/:slug  /:slug    301

# Installers for the desktop app. The paths stay version-free: each one
# resolves to a stable-named object in the toolbit-downloads R2 bucket,
# served from https://downloads.toolbit.app. R2's free plan carries the
# installers (10 GB storage, no egress fees), and the desktop release
# workflow mirrors every tagged release there under the same stable names,
# so this file never needs a release bump. A redirect rather than a
# rewrite, because the binaries live on another origin (Pages rejects files
# over 25 MiB, and the installers are bigger).
/download            /about#download   302
/download/mac        https://downloads.toolbit.app/Toolbit-macos-aarch64.dmg   302
/download/mac-intel  https://downloads.toolbit.app/Toolbit-macos-x64.dmg   302
/download/windows    https://downloads.toolbit.app/Toolbit-windows-x64-setup.exe   302
/download/linux      https://downloads.toolbit.app/Toolbit-linux-x86_64.AppImage   302
