# Site-wide security headers. The path has to stay `/*`: a bare `/` matches
# only the root URL, and every route in this single-page app must carry the
# policy.
/*
  # No third-party script is loaded and there is no telemetry endpoint, so
  # `script-src` stays at `'self'`. `connect-src` carries exactly two
  # non-origin allowances, one per user-driven network tool against a host the
  # user types: `https:` (API Request Builder) and `wss:` (WebSocket tester).
  # Both are accepted in the debt register (PRIVACY.md §7); the zero-egress
  # spec is the runtime tripwire. `object-src`/`frame-src` are closed rather
  # than inherited, and `base-uri` is closed outright — nothing in the app uses
  # `<base>`, and a `<base>` injected into rendered content would silently
  # re-point every relative URL on the page.
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https:; connect-src 'self' https: wss:; worker-src 'self' blob:; frame-src 'none'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; manifest-src 'self'
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  # The workspace is a single origin with no popups, no embeddable assets and no
  # device APIs: close the cross-origin windows and the device prompts the app
  # never asks for. `interest-cohort`/`browsing-topics` opt out of ad-topic
  # derivation as well.
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: accelerometer=(), autoplay=(), browsing-topics=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), interest-cohort=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=()

# Content-hashed filenames: a change ships a new URL, so these never need
# revalidating. Without this Cloudflare defaults to max-age=14400.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/og/*
  Cache-Control: public, max-age=604800

# The HTML entry points must stay fresh so a deploy is picked up immediately.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: public, max-age=0, must-revalidate
